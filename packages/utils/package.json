{
	"name": "@oh-my-pi/pi-utils",
	"version": "18.14.0",
	"description": "Shared utilities for pi packages",
	"keywords": [
		"cli",
		"logging",
		"streams",
		"utilities"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"license": "MIT",
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/utils"
	},
	"files": [
		"src",
		"dist/node",
		"scripts",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./ar": {
			"types": "./src/ar/index.ts",
			"import": "./src/ar/index.ts"
		},
		"./runtime": {
			"bun": { "types": "./src/runtime.ts", "import": "./src/runtime.ts" },
			"node": { "types": "./src/runtime.ts", "import": "./dist/node/runtime.mjs", "require": "./dist/node/runtime.mjs" },
			"types": "./src/runtime.ts",
			"import": "./src/runtime.ts"
		},
		"./runtime-process": {
			"bun": { "types": "./src/runtime-process.ts", "import": "./src/runtime-process.ts" },
			"node": { "types": "./src/runtime-process.ts", "import": "./dist/node/runtime.mjs", "require": "./dist/node/runtime.mjs" },
			"types": "./src/runtime-process.ts",
			"import": "./src/runtime-process.ts"
		},
		"./runtime-image": {
			"bun": { "types": "./src/runtime-image.ts", "import": "./src/runtime-image.ts" },
			"node": { "types": "./src/runtime-image.ts", "import": "./dist/node/runtime-image.mjs", "require": "./dist/node/runtime-image.mjs" },
			"types": "./src/runtime-image.ts",
			"import": "./src/runtime-image.ts"
		},
		"./sqlite-driver": {
			"bun": { "types": "./src/sqlite-driver.ts", "import": "./src/sqlite-driver.ts" },
			"node": { "types": "./src/sqlite-driver.ts", "import": "./dist/node/sqlite-driver.mjs", "require": "./dist/node/sqlite-driver.mjs" },
			"types": "./src/sqlite-driver.ts",
			"import": "./src/sqlite-driver.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"gen:bundle:node": "bun scripts/bundle-node.ts",
		"prepack": "bun run gen:bundle:node",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test --parallel",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/pi-natives": "catalog:",
		"fast-glob": "^3.3.3",
		"json5": "^2.2.3",
		"jsonc-parser": "^3.3.1",
		"koffi": "^2.15.1",
		"mime": "^4.1.0",
		"picomatch": "^4.0.3",
		"semver": "^7.8.5",
		"sharp": "^0.35.4",
		"smol-toml": "^1.4.2",
		"string-width": "8.2.2",
		"wrap-ansi": "10.0.0",
		"ws": "^8.18.3",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@ts-morph/common": "catalog:",
		"@types/picomatch": "^4.0.2",
		"@types/semver": "^7.7.1",
		"@types/ws": "^8.18.1"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=24.0.0"
	}
}
